# ============================================
# Authentication
# ============================================
# Admin username for dashboard login
ADMIN_USERNAME=admin
# Bind dashboard sessions to this users.id. Required if more than one user exists.
ADMIN_USER_ID=

# Single-user API key. Accepted by src/middleware/auth.ts as an
# alias for whichever one user exists (or ADMIN_USER_ID if set).
API_KEY=

# Gates the userscript auto-update route (/u/<token>/readsync.user.js) so its URL
# isn't guessable. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
USERSCRIPT_UPDATE_TOKEN=

# Admin password hash - Generate using: node generate-password-hash.js
ADMIN_PASSWORD_HASH=

# Session secret - Generate using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ============================================
# Server Configuration
# ============================================
# Port the server will listen on
PORT=3000

# Database connection string (PostgreSQL/Supabase)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional PEM CA certificate for remote PostgreSQL TLS (verification is mandatory).
PG_SSL_CA=

# Node environment (development, production, test)
NODE_ENV=development

# Optional. Comma-separated CORS + Socket.IO origin allowlist. Default: the
# production Render origin and http://localhost:3000 (+ :5173 outside production).
# ALLOWED_ORIGINS=

# Optional Postgres pool tuning (src/config.ts). Defaults shown.
# PG_POOL_MAX=15
# PG_IDLE_TIMEOUT=30000
# PG_CONN_TIMEOUT=10000

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (KEEP SECRET! Server-side only, never expose to frontend)
# Only Supabase credential actually read by the backend — Storage access
# in BackupService.ts and covers.ts.
SUPABASE_SERVICE_KEY=

# ============================================
# Error alerting (optional)
# ============================================
# Webhook that runtime errors are POSTed to as JSON (Slack/Discord incoming
# webhook, ntfy, or any endpoint that accepts a POST). Unset = alerting off,
# errors reach stdout only. See src/services/Alerter.ts.
ALERT_WEBHOOK_URL=

# Per-error cooldown before the same error alerts again. Default 900000 (15m).
ALERT_COOLDOWN_MS=

# Hard ceiling on alerts per hour, across all errors. Default 20 — a bad
# deploy can throw a *different* error per request, which the per-error
# cooldown alone would not hold down.
ALERT_MAX_PER_HOUR=

# ============================================
# Not read by the server
# ============================================
# Enables the integration tests. Must be a localhost database named
# readsync_audit (enforced by __tests__/setup.ts). See docs/TESTING.md.
# READSYNC_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/readsync_audit

# Session-pooler URL for the manual full-database dump in docs/BACKUPS.md.
# DUMP_URL=
