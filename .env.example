# ============================================
# Authentication
# ============================================
# Admin username for dashboard login
ADMIN_USERNAME=admin
# Bind dashboard sessions to this users.id. Required if more than one user exists.
ADMIN_USER_ID=

# Single-user shortcut key, embedded in the userscript build at build time
# (see userscript/vite.config.ts). Accepted by src/middleware/auth.ts as an
# alias for whichever one user exists (or ADMIN_USER_ID if set).
API_KEY=

# Gates the userscript auto-update route (/u/<token>/readsync.user.js) so the
# built file — which embeds API_KEY in plaintext — isn't fetchable by anyone
# who guesses the plain /readsync.user.js path. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
USERSCRIPT_UPDATE_TOKEN=

# Admin password hash - Generate using: node generate-password-hash.js
ADMIN_PASSWORD_HASH=

# Session secret - Generate using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ============================================
# Server Configuration
# ============================================
# Port the server will listen on
PORT=3000

# Database connection string (PostgreSQL/Supabase)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/database
# Optional PEM CA certificate for remote PostgreSQL TLS (verification is mandatory).
PG_SSL_CA=

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (KEEP SECRET! Server-side only, never expose to frontend)
# Only Supabase credential actually read by the backend — Storage access
# in BackupService.ts and covers.ts.
SUPABASE_SERVICE_KEY=

# ============================================
# Error alerting (optional)
# ============================================
# Webhook that runtime errors are POSTed to as JSON (Slack/Discord incoming
# webhook, ntfy, or any endpoint that accepts a POST). Unset = alerting off,
# errors reach stdout only. See src/services/Alerter.ts.
ALERT_WEBHOOK_URL=

# Per-error cooldown before the same error alerts again. Default 900000 (15m).
ALERT_COOLDOWN_MS=

# Hard ceiling on alerts per hour, across all errors. Default 20 — a bad
# deploy can throw a *different* error per request, which the per-error
# cooldown alone would not hold down.
ALERT_MAX_PER_HOUR=
