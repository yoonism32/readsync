# ============================================
# Authentication
# ============================================
# Admin username for dashboard login
ADMIN_USERNAME=admin

# Admin password hash - Generate using: node generate-password-hash.js
ADMIN_PASSWORD_HASH=

# Session secret - Generate using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ============================================
# Server Configuration
# ============================================
# Port the server will listen on
PORT=3000

# Database connection string (PostgreSQL/Supabase)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://user:password@host:5432/database

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Service Toggles
# ============================================
# Set to 1 to disable the chapter update bot
BOT_DISABLED=0

# API key for the userscript/extension to authenticate with the server
API_KEY=change-me

# ============================================
# Supabase Configuration
# ============================================
# Your Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous key (public, safe to expose in frontend)
SUPABASE_ANON_KEY=

# Supabase service role key (KEEP SECRET! Server-side only, never expose to frontend)
SUPABASE_SERVICE_KEY=
